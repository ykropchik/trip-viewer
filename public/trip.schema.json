{
  "$ref": "#/definitions/Trip",
  "definitions": {
    "Trip": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "type": "number",
          "const": 2
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-_]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "travelers": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Когда план последний раз менялся"
        },
        "categories": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "Название категории для легенды"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "Цвет маркеров категории"
              }
            },
            "required": [
              "label",
              "color"
            ],
            "additionalProperties": false
          }
        },
        "places": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "description": "Ключ из categories"
              },
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "query": {
                "type": "string",
                "description": "Строка поиска для Google Maps; по умолчанию name"
              },
              "note": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "Сайт места"
              }
            },
            "required": [
              "name",
              "category",
              "lat",
              "lon"
            ],
            "additionalProperties": false
          }
        },
        "stays": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-_]*$"
              },
              "city": {
                "type": "string",
                "minLength": 1,
                "description": "Город или база, например «Токио»"
              },
              "area": {
                "type": "string",
                "minLength": 1,
                "description": "Район или конкретный отель"
              },
              "checkIn": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "checkOut": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "radiusKm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 30,
                "default": 1.5,
                "description": "Радиус района, где искать жильё"
              },
              "why": {
                "type": "string",
                "description": "Почему этот район"
              },
              "alt": {
                "type": "string",
                "description": "Альтернатива или оговорка"
              },
              "hotel": {
                "type": "string",
                "description": "Название забронированного отеля"
              }
            },
            "required": [
              "id",
              "city",
              "area",
              "checkIn",
              "checkOut",
              "lat",
              "lon"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "stay": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "id из stays — где ночуем; null в день вылета"
              },
              "timeline": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "time": {
                      "type": "string",
                      "description": "Время или часть дня: «09:25», «утро», «вечер»"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Остановка: что делаем"
                    },
                    "place": {
                      "type": "string",
                      "description": "Остановка: ключ из places; без него пункт показывается без точки на карте"
                    },
                    "move": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Переезд: как едем, например «Синкансэн, Токио → Нагоя»"
                    },
                    "duration": {
                      "type": "string",
                      "description": "Переезд: сколько в пути, например «~1 ч 40 мин»"
                    }
                  },
                  "additionalProperties": false
                },
                "default": [],
                "description": "Остановки и переезды в порядке дня"
              },
              "tip": {
                "type": "string"
              }
            },
            "required": [
              "date",
              "title"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "highspeed",
                  "rail"
                ],
                "default": "rail"
              },
              "path": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": [
                    {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    }
                  ]
                },
                "minItems": 2,
                "description": "Точки линии: [долгота, широта]"
              }
            },
            "required": [
              "name",
              "path"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "bookings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-_]*$"
              },
              "what": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "type": "string",
                "minLength": 1,
                "description": "Когда бронировать, текстом"
              },
              "deadline": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Крайняя дата, для сортировки и подсветки"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "done": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "id",
              "what",
              "when"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "budget": {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "default": "USD"
            },
            "note": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "what": {
                    "type": "string",
                    "minLength": 1
                  },
                  "how": {
                    "type": "string",
                    "description": "Как посчитано"
                  },
                  "min": {
                    "type": "number",
                    "minimum": 0
                  },
                  "max": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "what",
                  "min",
                  "max"
                ],
                "additionalProperties": false
              },
              "default": []
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "id",
        "title",
        "start",
        "end",
        "categories",
        "places",
        "days"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trip",
  "description": "Формат поездки для trip-viewer, версия 2. Связи между разделами (place, stay, category) проверяет сам сайт при импорте."
}
